{
	"name": "dcarrero/social-relay-for-postiz",
	"description": "Auto-publish WordPress content to social networks through your own Postiz instance.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/i18n-command": "^2.6",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"autoload": {
		"psr-4": {
			"SocialRelayCvi\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SocialRelayCvi\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.2.0"
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "phpunit",
		"i18n": [
			"wp i18n make-pot . languages/social-relay-for-postiz.pot --slug=social-relay-for-postiz --domain=social-relay-for-postiz --exclude=vendor,tests,node_modules",
			"wp i18n update-po languages/social-relay-for-postiz.pot languages/",
			"wp i18n make-mo languages/",
			"wp i18n make-json languages/ --pretty-print"
		]
	}
}

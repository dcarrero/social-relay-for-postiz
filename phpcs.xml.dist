<?xml version="1.0"?>
<ruleset name="Social Relay for Postiz">
	<description>Coding standards for Social Relay for Postiz.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- PSR-4 file names (src/Postiz/Client.php) instead of class-*.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Conflicts with PHPStan generics such as list<string> in @param. -->
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="social-relay-for-postiz"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="socialrelaycvi"/>
				<element value="SocialRelayCvi"/>
			</property>
		</properties>
	</rule>
</ruleset>

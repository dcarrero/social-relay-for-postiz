#: build/settings.js:10
msgid "Set it up in Postiz"
msgstr "Configúralo en Postiz"

#: build/settings.js:10
msgid "In Postiz, open Settings → Webhooks and add a webhook."
msgstr "En Postiz, abre Settings → Webhooks y añade un webhook."

#: build/settings.js:10
msgid "Give it a name (for example “WordPress”), paste the URL above and choose all channels, or the ones used on this site."
msgstr "Ponle un nombre (por ejemplo «WordPress»), pega la URL de arriba y elige todos los canales, o los que uses en este sitio."

#: build/settings.js:10
msgid "Save it and press “Send test”: the call appears below within a few seconds."
msgstr "Guárdalo y pulsa «Send test»: el aviso aparece abajo en unos segundos."

#: build/settings.js:10
msgid "The URL answers. Postiz can use it if it can reach this site."
msgstr "La URL responde. Postiz puede usarla si llega hasta este sitio."

#: build/settings.js:10
msgid "The URL answers “not found” (404). The REST API may be off or rewritten: check the permalinks and any plugin that limits the REST API."
msgstr "La URL responde «no encontrada» (404). Puede que la API REST esté desactivada o reescrita: revisa los enlaces permanentes y cualquier plugin que limite la API REST."

#. translators: %d: HTTP status code.
#: build/settings.js:11
#, js-format
msgid "The URL is blocked (%d). A security plugin, Cloudflare or a firewall is stopping calls to the REST API: allow /wp-json/socialrelaycvi/v1/webhook/."
msgstr "La URL está bloqueada (%d). Un plugin de seguridad, Cloudflare o un cortafuegos frena las llamadas a la API REST: permite /wp-json/socialrelaycvi/v1/webhook/."

#: build/settings.js:11
msgid "This server could not call its own address. Many hosts block that, so it does not mean Postiz cannot: use “Send test” in Postiz to be sure."
msgstr "Este servidor no ha podido llamar a su propia dirección. Muchos alojamientos lo bloquean, así que no significa que Postiz no pueda: usa «Send test» en Postiz para asegurarte."

#. translators: %d: HTTP status code.
#: build/settings.js:12
#, js-format
msgid "Unexpected answer (%d). Use “Send test” in Postiz to check it."
msgstr "Respuesta inesperada (%d). Usa «Send test» en Postiz para comprobarlo."

#: build/settings.js:12
msgid "Check URL"
msgstr "Comprobar URL"

#: build/settings.js:12
msgid "Create a new URL"
msgstr "Crear una URL nueva"

#: build/settings.js:12
msgid "Create new URL"
msgstr "Crear URL nueva"

#: build/settings.js:12
msgid "The current URL stops working at once, and you will have to paste the new one in Postiz. Continue?"
msgstr "La URL actual deja de funcionar al momento y tendrás que pegar la nueva en Postiz. ¿Continuar?"

#: build/settings.js:12
msgid "Last calls"
msgstr "Últimos avisos"

#: build/settings.js:12
msgid "No calls yet. The first one shows up here when Postiz publishes, or when you press “Send test”."
msgstr "Aún no hay avisos. El primero aparecerá aquí cuando Postiz publique o cuando pulses «Send test»."

#: build/settings.js:12
msgid "Read from the POSTIZ_API_KEY environment variable."
msgstr "Se lee de la variable de entorno POSTIZ_API_KEY."

#: build/settings.js:12
msgid "Defined in wp-config.php (SOCIALRELAYCVI_POSTIZ_API_KEY)."
msgstr "Definida en wp-config.php (SOCIALRELAYCVI_POSTIZ_API_KEY)."

#: build/settings.js:12

msgstr "Instancia de Postiz"

#: build/settings.js:13
msgid "Statuses update at once through the Postiz webhook."
msgstr "Los estados se actualizan al momento con el webhook de Postiz."

#: build/settings.js:13
msgid "Statuses update every 15 minutes. Set up the webhook (Webhook tab) to get them at once."
msgstr "Los estados se actualizan cada 15 minutos. Configura el webhook (pestaña Webhook) para tenerlos al momento."

#. translators: %d: number of channels.
#: build/settings.js:14
#, php-format,js-format
msgid "Connected to Postiz. %d channel available."
msgid_plural "Connected to Postiz. %d channels available."
msgstr[0] "Conectado a Postiz. %d canal disponible."
msgstr[1] "Conectado a Postiz. %d canales disponibles."

#: build/settings.js:14
msgid "Postiz URL"
msgstr "URL de Postiz"

#. translators: %s: detected API URL.
#: build/settings.js:15
#, js-format
msgid "Detected API: %s"
msgstr "API detectada: %s"

#: build/settings.js:15
msgid "Your self-hosted Postiz address. For Postiz Cloud, use https://api.postiz.com."
msgstr "La dirección de tu Postiz autoalojado. Si usas Postiz Cloud, pon https://api.postiz.com."

#: build/settings.js:15
msgid "API key"
msgstr "Clave de API"

#: build/settings.js:15
msgid "Paste your API key"
msgstr "Pega tu clave de API"

#: build/settings.js:15
msgid "Postiz → Settings → Developers → Public API. Leave empty to keep the current key. For better security define SOCIALRELAYCVI_POSTIZ_API_KEY in wp-config.php or the POSTIZ_API_KEY environment variable."
msgstr "Postiz → Settings → Developers → Public API. Déjalo vacío para mantener la clave actual. Para más seguridad, define SOCIALRELAYCVI_POSTIZ_API_KEY en wp-config.php o la variable de entorno POSTIZ_API_KEY."

#: build/settings.js:15
msgid "Save and test connection"
msgstr "Guardar y probar la conexión"

#: build/settings.js:15
msgid "Postiz public API documentation"
msgstr "Documentación de la API pública de Postiz"

#: build/settings.js:15
#: build/settings.js:16
msgid "Categories"
msgstr "Categorías"

#. translators: %d: number of categories.
#: build/settings.js:16
#, js-format
msgid "%d category selected."
msgid_plural "%d categories selected."
msgstr[0] "%d categoría marcada."
msgstr[1] "%d categorías marcadas."

#: build/settings.js:16
msgid "Search categories"
msgstr "Buscar categorías"

#: build/settings.js:16
msgid "No categories match."
msgstr "Ninguna categoría coincide."

#: build/settings.js:16
msgid "Only"
msgstr "Solo"

#: build/settings.js:16
msgid "Share only posts with at least one of these. Empty: any post."
msgstr "Solo se comparten las entradas con al menos una de estas. Vacío: cualquier entrada."

#: build/settings.js:16
msgid "Never"
msgstr "Nunca"

#: build/settings.js:16
msgid "Never share posts with any of these, even if they match “Only”."
msgstr "Nunca se comparten las entradas con alguna de estas, aunque cumplan «Solo»."

#: build/settings.js:16
msgid "Choose which posts are shared by their categories and tags (those of this site). Leave everything empty to share all posts."
msgstr "Elige qué entradas se comparten según sus categorías y etiquetas (las de este sitio). Déjalo todo vacío para compartir todas las entradas."

#: build/settings.js:16
msgid "Tags"
msgstr "Etiquetas"

#: build/settings.js:16
msgid "customized"
msgstr "personalizada"

#. translators: %d: character limit of the network.
#: build/settings.js:17
#, js-format
msgid "Template for this network (limit: %d characters)"
msgstr "Plantilla para esta red (límite: %d caracteres)"

#: build/settings.js:17
msgid "Template for this network"
msgstr "Plantilla para esta red"

#: build/settings.js:17
msgid "Empty = common template"
msgstr "Vacío = plantilla común"

#: build/settings.js:17
msgid "Default"
msgstr "Por defecto"

#. translators: %s: post type label, e.g. Posts.
#: build/settings.js:18
#, php-format,js-format
msgid "Share %s when they are published"
msgstr "Compartir %s cuando se publiquen"

#: build/settings.js:18
msgid "No channels in Postiz yet. Add them in Postiz and reload this page."
msgstr "Todavía no hay canales en Postiz. Añádelos en Postiz y recarga esta página."

#. translators: %d: number of channels.
#: build/settings.js:19
#, js-format
msgid "%d channel of this profile no longer exists in Postiz and is skipped."
msgid_plural "%d channels of this profile no longer exist in Postiz and are skipped."
msgstr[0] "%d canal de este perfil ya no existe en Postiz y se omite."
msgstr[1] "%d canales de este perfil ya no existen en Postiz y se omiten."

#: build/settings.js:19
msgid "Message template"
msgstr "Plantilla del mensaje"

#: build/settings.js:19
msgid "Use “Insert tag” for the post data. Filters such as |limit:100, |words:30, |upper, |hashtag or |default:text go inside a tag. A line with --- starts a new thread part."
msgstr "Usa «Insertar etiqueta» para los datos de la entrada. Los filtros como |limit:100, |words:30, |upper, |hashtag o |default:texto van dentro de una etiqueta. Una línea con --- empieza una nueva parte del hilo."

#: build/settings.js:19
msgid "Optional. A network without its own template uses the common one."
msgstr "Opcional. Las redes sin plantilla propia usan la común."

#: build/settings.js:19
msgid "Delay in minutes"
msgstr "Retraso en minutos"

#: build/settings.js:19
msgid "Up to 10 images; each network gets as many as it accepts (X 4, LinkedIn 9, Instagram 10, Pinterest 1). The editor can choose others for each post."
msgstr "Hasta 10 imágenes; cada red recibe las que admite (X 4, LinkedIn 9, Instagram 10, Pinterest 1). En el editor se pueden elegir otras para cada entrada."

#: build/settings.js:19
msgid "Allow sharing again on update (when requested from the editor)"
msgstr "Permitir volver a compartir al actualizar (cuando se pida desde el editor)"

#: build/settings.js:19
msgid "Conditions"
msgstr "Condiciones"

#: build/settings.js:19
msgid "Links and tags"
msgstr "Enlaces y etiquetas"

#: build/settings.js:19
msgid "Add UTM parameters to {url} (utm_source = network, utm_medium = social)"
msgstr "Añadir parámetros UTM a {url} (utm_source = red, utm_medium = social)"

#: build/settings.js:19
msgid "Accepts tags, e.g. {slug}."
msgstr "Admite variables, por ejemplo {slug}."

#: build/settings.js:19
msgid "Shorten links with Postiz"
msgstr "Acortar los enlaces con Postiz"

#: build/settings.js:19
msgid "Tag the posts in Postiz with the post categories"
msgstr "Etiquetar las publicaciones en Postiz con las categorías de la entrada"

#: build/settings.js:21
msgid "Test this profile"
msgstr "Probar este perfil"

#: build/settings.js:21
msgid "Pick a post to see the messages the saved profile would send. Nothing is sent."
msgstr "Elige una entrada para ver los mensajes que enviaría el perfil guardado. No se envía nada."

#: build/settings.js:21
msgid "Save the profile to test your latest changes."
msgstr "Guarda el perfil para probar tus últimos cambios."

#: build/settings.js:21
msgid "Type to search a post…"
msgstr "Escribe para buscar una entrada…"


msgstr "Opcional. Un canal sin plantilla propia usa la común."

#: build/settings.js:19
msgid "Delay in minutes"
msgstr "Retraso en minutos"

#: build/settings.js:19
msgid "Up to 10 images; each network gets as many as it accepts (X 4, LinkedIn 9, Instagram 10, Pinterest 1). The editor can choose others for each post."
msgstr "Hasta 10 imágenes; cada red recibe las que admite (X 4, LinkedIn 9, Instagram 10, Pinterest 1). En el editor se pueden elegir otras para cada entrada."

#: build/settings.js:19
